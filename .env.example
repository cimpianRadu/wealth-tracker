# Baza de date Neon (regiune UE). Connection string-ul „pooled”.
DATABASE_URL=

# Semnează sesiunile și codurile de intrare. Minim 32 de caractere aleatoare:
#   openssl rand -base64 48
AUTH_SECRET=

# Adresa publică, fără „/” la final. Folosită în linkurile de invitație și la Google.
APP_URL=https://wealthtracker.ro

# Login cu Google (OAuth client de tip „Web application” în Google Cloud Console).
# Authorized redirect URI: https://wealthtracker.ro/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emailuri (codul de intrare, reminderele). Fără cheie, în dev codul apare în consolă.
RESEND_API_KEY=
RESEND_FROM=Wealth Tracker <cont@wealthtracker.ro>

# Citirea extraselor și asistentul.
ANTHROPIC_API_KEY=
# Opțional, ca să schimbi modelul fără deploy:
# EXTRACT_MODEL=claude-sonnet-5-5
# ASSISTANT_MODEL=claude-sonnet-5-5

# Protejează /api/cron/reminders. Același secret și în GitHub Actions.
CRON_SECRET=
